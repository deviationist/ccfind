# ccfind — optional per-machine config.
#
# Copy this file to `.env` (gitignored) in the same directory as `ccfind.zsh`.
# ccfind auto-sources it when you use `-r` / `ccfindr` (multi-host) or tab views.
# Every value is optional: with none set, ccfind is purely local — exactly the
# default behavior. You can also export any of these from ~/.zshrc instead; an
# exported value takes precedence over the one here.

# Local Claude profiles to search: space/comma-separated "label:configdir" pairs.
# Each <configdir> is a Claude config dir (the one holding a projects/ subdir).
# ccfind unions them and tags each hit with its label; `ccfind <label> ...` or
# `ccfind -p <label> ...` scopes to one. Unset → just ~/.claude (single profile).
typeset CCFIND_PROFILES="work:$HOME/.claude personal:$HOME/.claude-personal"

# Space/comma-separated ssh aliases to fan a search out to with `ccfind -r`
# (or the `ccfindr` alias). Each host is searched over ssh in parallel with the
# local search. Configuring this alone changes nothing — plain `ccfind` stays
# local; you opt in per call with -r/-H.
typeset CCFIND_HOSTS="host-a host-b"

# Set to 1 to add tab views (All | <profile> | <host>...) to the multi-host or
# multi-profile fzf picker (Tab / Shift-Tab cycle them). Needs fzf >= 0.45;
# unset/0 = plain merged list.
typeset CCFIND_TABS=1

# How case is matched, unless a flag overrides it on the call:
#   insensitive  (default)  what ccfind has always done — "foobar" finds "FooBar"
#   sensitive               the query's own casing, and only that
#   smart                   insensitive until the query itself has a capital,
#                           the convention rg / fzf / vim share
# Per call: -s/--case-sensitive, -I/--ignore-case, -S/--smart-case. Smart is the
# one worth setting here — it reads the intent off the query instead of off a
# flag you have to remember. "Has a capital" means an ASCII capital, so a query
# with no case to express (an id, a path, a non-Latin script) still folds.
# typeset CCFIND_CASE="smart"

# What the time column shows on each hit:
#   both  (default)  the mtime and its age — "2026-08-20 14:32:05  (5h ago)"
#   abs              the mtime alone, as ccfind printed it before ages existed
#   rel              the age alone — narrower, for a terminal where the snippet
#                    is worth more than the date
# The date tells you WHEN a session was; the age tells you HOW LONG AGO, which
# is the question you are actually asking while scanning a list. --json/--tsv
# are unaffected either way: they carry the raw epoch and the mtime.
# typeset CCFIND_TIME="both"

# Override how a REMOTE hit is resumed. Set to a command/function name; ccfind
# calls it as `<cmd> <host> <cwd> <session-id>` instead of its built-in
# `ssh -t <host> ... claude --resume`. Use it to wrap the remote session in
# tmux/screen (so it survives a dropped link), mosh, etc. The function must be
# available in your interactive shell. Unset = built-in ssh resume.
# typeset CCFIND_REMOTE_RESUME="my-remote-claude"

# Where ccfind is installed on the REMOTE hosts, if not one of the conventional
# locations (~/ccfind/ccfind.zsh, ~/.zsh/ccfind/ccfind.zsh,
# ~/.config/ccfind/ccfind.zsh). When the worker finds a ccfind on a host it asks
# that host for its results, so the host's OWN profiles are searched and hits
# come back tagged <host>:<profile>. Without one, that host contributes its
# ~/.claude only — a quiet fallback, which `ccfind -v` will tell you about.
# Note the far end reads the .env beside ITS ccfind.zsh, not this one.
# typeset CCFIND_REMOTE_PATH="$HOME/ccfind/ccfind.zsh"

# Where claude-profile lives, if you use it to manage your Claude seats and it
# is not at one of the conventional paths (~/claude-profile/claude-profile.py,
# ~/.zsh/claude-profile/claude-profile.py, ~/.config/claude-profile/…).
# Only consulted when CCFIND_PROFILES above is unset: claude-profile already
# knows your profiles, so listing them twice is a copy that drifts.
# typeset CCFIND_PROFILE_PATH="$HOME/claude-profile/claude-profile.py"
